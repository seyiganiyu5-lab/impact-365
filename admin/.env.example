# Copy to .env.local and fill in from Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Optional: Google's own sign-in button (shows this site's address, not Supabase's).
# The *Web* client ID from Google Cloud → APIs & Services → Credentials.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
